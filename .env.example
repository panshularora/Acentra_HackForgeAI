# Copy to .env and adjust. Every value has a sensible default in backend/app/config.py.

APP_NAME=ClaimsWatch

# Ingest
LOG_PATH=logs/app.log
DB_PATH=claimswatch.db

# Detection (seconds, counts, modified z-score thresholds)
WINDOW_SECONDS=60
BUCKET_SECONDS=10
BASELINE_BUCKETS=30
BASELINE_MIN_BUCKETS=6
MIN_ERRORS=5
MIN_TOTAL=50
MAD_FLOOR=0.002
TEMPLATE_MAD_FLOOR=1.0
MAX_TEMPLATES=500
TEMPLATE_SIMILARITY=0.5
THRESHOLD_WARNING=3.5
THRESHOLD_HIGH=5.0
THRESHOLD_CRITICAL=8.0
RESOLVE_AFTER_BUCKETS=3

# AWS delivery. With AWS_ENDPOINT_URL set, boto3 talks to the local moto
# emulator (any credentials work). Remove it to publish to a real account;
# credentials then come from the standard AWS chain (environment variables,
# ~/.aws/credentials or an IAM role). AWS_ENABLED=false turns delivery off.
AWS_ENABLED=true
AWS_ENDPOINT_URL=http://localhost:5000
AWS_REGION=us-east-1
SNS_TOPIC_NAME=claimswatch-alerts
CW_LOG_GROUP=/claimswatch/alerts
CW_LOG_STREAM=anomalies

# Real AWS instead of moto: delete AWS_ENDPOINT_URL above, then set these.
# SNS_TOPIC_ARN publishes to an existing topic without creating one, so the key
# only needs sns:Publish on it. CW_ENABLED=false skips CloudWatch Logs when the
# key has no logs permissions. Never commit the real .env.
# AWS_REGION=ap-south-1
# SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:<ACCOUNT_ID>:log-anomaly-alerts
# CW_ENABLED=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
